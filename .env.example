# ============================================
# Browser Automation System - Configuration
# ============================================

# API Keys (required)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# browser-use optimized API (optional, faster & cheaper)
# Get your key at https://browser-use.com
BROWSER_USE_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
HEADLESS=false

# Data Directory
DATA_DIR=data

# Browser Configuration
BROWSER_TIMEOUT=60000
MAX_BROWSER_STEPS=50

# Logging
LOG_LEVEL=info
